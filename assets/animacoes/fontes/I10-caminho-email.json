  "steps": [
    {"time": 0.5, "caption": "No programa do remetente, a mensagem tem destinatários em Para, Cc e Cco."},
    {"time": 3.4, "caption": "O SMTP faz o envio: leva a mensagem do programa ao servidor de saída."},
    {"time": 5.6, "caption": "O SMTP também leva a mensagem de um servidor a outro, até o servidor do destinatário."},
    {"time": 8.0, "caption": "No recebimento, o POP3 baixa a mensagem para o dispositivo; no IMAP, ela fica no servidor e é sincronizada."},
    {"time": 10, "caption": "Para e Cc aparecem para todos os destinatários; o Cco, só para o remetente."}
