n":[{"tag":"strong","children":["Como?:"]}," Explique a providência esperada."]}]}],"tone":"description"},{"tag":"aside","children":[{"tag":"span","children":["Atenção"],"tone":"label"},{"tag":"p","children":["Concisão preserva as informações necessárias. Retirar prazo, responsável ou documento exigido pode tornar a mensagem incompleta."]}],"tone":"attention"}],"attrs":{"id":"lesson-A02-esquema"},"tone":"diagram"},{"tag":"div","children":[{"tag":"h2","children":["Mapa do conteúdo"]},{"tag":"ol","children":[{"tag":"li","children":[{"tag":"a","children":["1. Rotina administrativa"],"attrs":{"href":"#lesson-A02-s1"}}]},{"tag":"li","children":[{"tag":"a","children":["2. Ata"],"attrs":{"href":"#lesson-A02-s2"}}]},{"tag":"li","children":[{"tag":"a","children":["3. Ofício e memorando"],"attrs":{"href":"#lesson-A02-s3"}}]},{"tag":"li","children":[{"tag":"a","children":["4. Formulários, tabelas e planilhas"],"attrs":{"href":"#lesson-A02-s4"}}]},{"tag":"li","children":[{"tag":"a","children":["5. Organograma e fluxograma"],"attrs":{"href":"#lesson-A02-s5"}}]}],"tone":"contents"}],"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["1. Rotina administrativa"]},{"tag":"p","children":["Rotina administrativa é o conjunto de procedimentos repetidos que mantém o fluxo de trabalho: receber demandas, registrar, distribuir, acompanhar, arquivar e comunicar resultados. Uma boa rotina define responsabilidades, prazos, registros e pontos de controle."]}],"attrs":{"id":"lesson-A02-s1"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["2. Ata"]},{"tag":"p","children":["Ata registra acontecimentos e deliberações de reunião. Deve permitir reconstruir o que ocorreu: data, local, participantes ou quórum conforme prática adotada, assuntos, decisões e encerramento. O foco é fidelidade e clareza, evitando opiniões pessoais do redator."]}],"attrs":{"id":"lesson-A02-s2"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["3. Ofício e memorando"]},{"tag":"p","children":["Ofícios são comunicações oficiais formais entre unidades, autoridades ou destinatários externos conforme a organização. Memorandos são tradicionalmente associados à comunicação interna. A terminologia pode variar em sistemas modernos, por isso em prova é importante seguir o conceito indicado pelo edital/contexto."]}],"attrs":{"id":"lesson-A02-s3"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["4. Formulários, tabelas e planilhas"]},{"tag":"p","children":["Formulários padronizam coleta de dados. Tabelas organizam informação em linhas e colunas. Planilhas permitem cálculos, registros e acompanhamento. Padronização reduz omissões e facilita conferência."]}],"attrs":{"id":"lesson-A02-s4"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["5. Organograma e fluxograma"]},{"tag":"p","children":["Organograma representa estrutura organizacional e relações de subordinação/coordenação. Fluxograma representa sequência de etapas, decisões e caminhos de um processo. Não confunda estrutura “quem responde a quem” com fluxo “o que acontece depois”."]},{"tag":"table","children":[{"tag":"thead","children":[{"tag":"tr","children":[{"tag":"th","children":["Ferramenta"]},{"tag":"th","children":["Representa"]}]}]},{"tag":"tbody","children":[{"tag":"tr","children":[{"tag":"td","children":["Organograma"]},{"tag":"td","children":["estrutura e relações organizacionais"]}]},{"tag":"tr","children":[{"tag":"td","children":["Fluxograma"]},{"tag":"td","children":["sequência e decisões de um processo"]}]},{"tag":"tr","children":[{"tag":"td","children":["Formulário"]},{"tag":"td","children":["campos padronizados para coleta"]}]},{"tag":"tr","children":[{"tag":"td","children":["Planilha"]},{"tag":"td","children":["dados tabulares e cálculos/acompanhamento"]}]}]}]}],"attrs":{"id":"lesson-A02-s5"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["Exemplos resolvidos passo a passo"]},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 1"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Reunião decide novo horário e responsáveis. Qual documento registra a deliberação?"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Ata, pois sua finalidade é registrar fatos e decisões da reunião."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 2"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Setor quer mapear caminho “recebe pedido → confere → devolve se incompleto → protocola”."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Fluxograma, pois representa etapas e ponto de decisão."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 3"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Gestor quer mostrar Diretoria > Gerências > Seções."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Organograma, porque representa estrutura hierárquica/organizacional."],"tone":"solution"}],"tone":"example"}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Pegadinha"],"tone":"label"},{"tag":"h2","children":["Pegadinhas e erros frequentes"]},{"tag":"ul","children":[{"tag":"li","children":["Transformar ata em texto opinativo."]},{"tag":"li","children":["Confundir organograma com fluxograma."]},{"tag":"li","children":["Criar formulário sem campos essenciais ou sem padronização."]},{"tag":"li","children":["Usar linguagem ambígua em documento administrativo."]}]}],"tone":"attention"},{"tag":"section","children":[{"tag":"span","children":["Resumo"],"tone":"label"},{"tag":"h2","children":["Resumo de prova"]},{"tag":"ul","children":[{"tag":"li","children":["Ata registra reunião e deliberação."]},{"tag":"li","children":["Ofício é comunicação oficial formal."]},{"tag":"li","children":["Memorando é tradicionalmente comunicação interna."]},{"tag":"li","children":["Formulário padroniza coleta."]},{"tag":"li","children":["Organograma = estrutura; fluxograma = processo."]}]}],"tone":"summary"},{"tag":"section","children":[{"tag":"h2","children":["Checklist de domínio"]},{"tag":"ul","children":[{"tag":"li","children":["☐ Entender finalidade e estrutura básica de documentos administrativos."]},{"tag":"li","children":["☐ Diferenciar ata, ofício, memorando e formulário."]},{"tag":"li","children":["☐ Interpretar organogramas e fluxogramas como ferramentas de organização."]}]},{"tag":"p","children":["Meta do módulo: 80% ou mais nas questões, sem depender de consulta."]}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Para aprofundar"]},{"tag":"h2","children":["Referências e conteúdos auxiliares"]},{"tag":"aside","children":[{"tag":"span","children":["Referência complementar"],"tone":"label"},{"tag":"p","children":["Leia as características da redação oficial no Manual da Presidência: clareza, precisão, objetividade, concisão e impessoalidade. Aplique-as a uma comunicação curta de rotina."]}],"tone":"reference"},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Presidência da República — Manual de Redação, 3ª edição"],"attrs":{"href":"https://www.gov.br/cidades/pt-br/midia/documentos/pdf/manualderedacao.pdf"}},{"tag":"small","children":["Clareza, redação oficial, concordância, regência e pontuação. Referência de apoio; modelos locais podem ter regras próprias."]}]}]},{"tag":"p","children":["Referências externas de apoio consultadas para este material em 27/09/2026. A origem das questões é o material autoral do projeto; estes links não indicam que uma instituição publicou ou validou os exercícios. As páginas externas precisam de internet. Em informática, confira a versão do programa; em legislação, observe o recorte e as regras de atualização do edital."]}],"attrs":{"id":"lesson-A02-referencias"},"tone":"sources"}]}
