"strong","children":["Saída:"]}," Identificar retirada e destinatário."]}]}],"tone":"description"},{"tag":"aside","children":[{"tag":"span","children":["Atenção"],"tone":"label"},{"tag":"p","children":["Saldo no sistema e quantidade física precisam ser conciliados. Uma diferença exige apuração e registro, não ajuste silencioso."]}],"tone":"attention"}],"attrs":{"id":"lesson-A04-esquema"},"tone":"diagram"},{"tag":"div","children":[{"tag":"h2","children":["Mapa do conteúdo"]},{"tag":"ol","children":[{"tag":"li","children":[{"tag":"a","children":["1. Recebimento"],"attrs":{"href":"#lesson-A04-s1"}}]},{"tag":"li","children":[{"tag":"a","children":["2. Conferência quantitativa e qualitativa"],"attrs":{"href":"#lesson-A04-s2"}}]},{"tag":"li","children":[{"tag":"a","children":["3. Armazenamento"],"attrs":{"href":"#lesson-A04-s3"}}]},{"tag":"li","children":[{"tag":"a","children":["4. Distribuição e registro"],"attrs":{"href":"#lesson-A04-s4"}}]},{"tag":"li","children":[{"tag":"a","children":["5. Reposição e estoque mínimo"],"attrs":{"href":"#lesson-A04-s5"}}]},{"tag":"li","children":[{"tag":"a","children":["6. Fornecedores"],"attrs":{"href":"#lesson-A04-s6"}}]}],"tone":"contents"}],"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["1. Recebimento"]},{"tag":"p","children":["Receber material não significa aceitá-lo automaticamente. A etapa inclui identificação do pedido/fornecedor e conferência da entrega. Divergências devem ser registradas e tratadas antes da aceitação definitiva, conforme procedimento."]}],"attrs":{"id":"lesson-A04-s1"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["2. Conferência quantitativa e qualitativa"]},{"tag":"p","children":["Conferência quantitativa verifica quantidade/unidades. Qualitativa compara especificações: modelo, marca quando exigida, dimensão, validade, integridade e demais requisitos. A nota fiscal deve ser confrontada com pedido/contrato e entrega física."]}],"attrs":{"id":"lesson-A04-s2"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["3. Armazenamento"]},{"tag":"p","children":["Materiais devem ser identificados e acondicionados de forma compatível, evitando deterioração, perda, mistura e riscos. Endereçamento de estoque facilita localização. Itens com validade exigem controle por lote/data."]}],"attrs":{"id":"lesson-A04-s3"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["4. Distribuição e registro"]},{"tag":"p","children":["Saídas precisam ser registradas para manter saldo confiável. Requisições internas e responsáveis ajudam a rastrear consumo. Saldo físico deve periodicamente ser comparado ao saldo registrado por inventário."]}],"attrs":{"id":"lesson-A04-s4"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["5. Reposição e estoque mínimo"]},{"tag":"p","children":["Reposição deve considerar consumo, tempo de fornecimento e margem de segurança. Estoque excessivo imobiliza recursos e aumenta risco de obsolescência; estoque insuficiente causa ruptura."]}],"attrs":{"id":"lesson-A04-s5"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["6. Fornecedores"]},{"tag":"p","children":["Relacionamento profissional com fornecedores exige registro de entregas, prazos, qualidade e divergências, respeitando regras contratuais e de administração pública aplicáveis."]}],"attrs":{"id":"lesson-A04-s6"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["Exemplos resolvidos passo a passo"]},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 1"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Pedido prevê 100 resmas, nota fiscal indica 100, mas chegam 96."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Há divergência quantitativa; deve ser registrada e tratada, não simplesmente dar entrada em 100."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 2"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Quantidade correta, mas produto tem especificação diferente."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," A conferência qualitativa detecta a não conformidade."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 3"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Sistema mostra 50 unidades e contagem física 43."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Há divergência de inventário a investigar antes de ajustar, verificando saídas não registradas, perdas ou erro de lançamento."],"tone":"solution"}],"tone":"example"}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Pegadinha"],"tone":"label"},{"tag":"h2","children":["Pegadinhas e erros frequentes"]},{"tag":"ul","children":[{"tag":"li","children":["Conferir apenas nota fiscal e não o material físico."]},{"tag":"li","children":["Dar saída sem registro."]},{"tag":"li","children":["Misturar itens sem identificação."]},{"tag":"li","children":["Confundir estoque alto com boa gestão."]}]}],"tone":"attention"},{"tag":"section","children":[{"tag":"span","children":["Resumo"],"tone":"label"},{"tag":"h2","children":["Resumo de prova"]},{"tag":"ul","children":[{"tag":"li","children":["Recebimento inclui conferência."]},{"tag":"li","children":["Quantitativa = quantidade; qualitativa = especificação/condição."]},{"tag":"li","children":["Saídas devem ser registradas."]},{"tag":"li","children":["Inventário compara físico x sistema."]},{"tag":"li","children":["Reposição equilibra risco de falta e excesso."]}]}],"tone":"summary"},{"tag":"section","children":[{"tag":"h2","children":["Checklist de domínio"]},{"tag":"ul","children":[{"tag":"li","children":["☐ Entender o ciclo de materiais do recebimento ao consumo."]},{"tag":"li","children":["☐ Aplicar conferência quantitativa e qualitativa."]},{"tag":"li","children":["☐ Reconhecer controles de estoque e reposição."]}]},{"tag":"p","children":["Meta do módulo: 80% ou mais nas questões, sem depender de consulta."]}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Para aprofundar"]},{"tag":"h2","children":["Referências e conteúdos auxiliares"]},{"tag":"aside","children":[{"tag":"span","children":["Referência complementar"],"tone":"label"},{"tag":"p","children":["Monte uma ficha simples com data, documento, entrada, saída e saldo. No material Gestão de Materiais da Enap, procure recebimento, armazenagem e distribuição. Relacione cada movimento a uma evidência."]}],"tone":"reference"},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Enap — Gestão de Materiais"],"attrs":{"href":"https://repositorio.enap.gov.br/bitstream/1/2268/1/Enap%20Did%C3%A1ticos%20-%20Gest%C3%A3o%20de%20Materiais.pdf"}},{"tag":"small","children":["Gestão de estoques, recebimento, armazenagem e distribuição. Referência conceitual; legislação e procedimentos devem ser conferidos na norma aplicável."]}]},{"tag":"li","children":[{"tag":"a","children":["Conarq — Criação e desenvolvimento de arquivos públicos municipais"],"attrs":{"href":"https://www.gov.br/conarq/pt-br/centrais-de-conteudo/publicacoes/Cartilha_criacao_arquivos_municipais.pdf"}},{"tag":"small","children":["Consulte especialmente gestão de documentos, protocolo, classificação, avaliação e destinação."]}]}]},{"tag":"p","children":["Referências externas de apoio consultadas para este material em 27/09/2026. A origem das questões é o material autoral do projeto; estes links não indicam que uma instituição publicou ou validou os exercícios. As páginas externas precisam de internet. Em informática, confira a versão do programa; em legislação, observe o recorte e as regras de atualização do edital."]}],"attrs":{"id":"lesson-A04-referencias"},"tone":"sources"}]}
