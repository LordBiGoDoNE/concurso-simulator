1. Documento e arquivo"],"attrs":{"href":"#lesson-A05-s1"}}]},{"tag":"li","children":[{"tag":"a","children":["2. Ciclo documental"],"attrs":{"href":"#lesson-A05-s2"}}]},{"tag":"li","children":[{"tag":"a","children":["3. Classificação e ordenação"],"attrs":{"href":"#lesson-A05-s3"}}]},{"tag":"li","children":[{"tag":"a","children":["4. Temporalidade"],"attrs":{"href":"#lesson-A05-s4"}}]},{"tag":"li","children":[{"tag":"a","children":["5. Eliminação e descarte"],"attrs":{"href":"#lesson-A05-s5"}}]},{"tag":"li","children":[{"tag":"a","children":["6. Conservação e documentos digitais"],"attrs":{"href":"#lesson-A05-s6"}}]}],"tone":"contents"}],"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["1. Documento e arquivo"]},{"tag":"p","children":["Documento registra informação produzida ou recebida no exercício de atividades. Arquivo, em sentido arquivístico, é o conjunto de documentos acumulados organicamente por pessoa ou instituição em função de suas atividades, além de poder designar local/serviço conforme contexto."]}],"attrs":{"id":"lesson-A05-s1"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["2. Ciclo documental"]},{"tag":"table","children":[{"tag":"thead","children":[{"tag":"tr","children":[{"tag":"th","children":["Fase"]},{"tag":"th","children":["Uso típico"]},{"tag":"th","children":["Destino"]}]}]},{"tag":"tbody","children":[{"tag":"tr","children":[{"tag":"td","children":["Corrente"]},{"tag":"td","children":["uso frequente, próximo ao setor produtor"]},{"tag":"td","children":["permanece ativo ou transfere"]}]},{"tag":"tr","children":[{"tag":"td","children":["Intermediário"]},{"tag":"td","children":["uso menos frequente, aguardando prazo"]},{"tag":"td","children":["eliminação ou recolhimento"]}]},{"tag":"tr","children":[{"tag":"td","children":["Permanente"]},{"tag":"td","children":["valor histórico/probatório duradouro"]},{"tag":"td","children":["guarda definitiva"]}]}]}]}],"attrs":{"id":"lesson-A05-s2"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["3. Classificação e ordenação"]},{"tag":"p","children":["Classificação organiza documentos por funções, assuntos ou plano adotado. Ordenação coloca unidades em sequência dentro da classe: alfabética, numérica, cronológica etc. Classificar e ordenar são operações relacionadas, mas não idênticas."]}],"attrs":{"id":"lesson-A05-s3"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["4. Temporalidade"]},{"tag":"p","children":["Tabela de temporalidade define prazos de guarda e destinação com base em valores administrativos, legais, fiscais e históricos. Não se elimina documento apenas porque “parece antigo”."]}],"attrs":{"id":"lesson-A05-s4"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["5. Eliminação e descarte"]},{"tag":"p","children":["Eliminação deve obedecer normas, autorizações e procedimentos, preservando sigilo e prova da operação quando exigido. O edital menciona descarte e incineração conforme normas de temporalidade: a ênfase é que destruição é controlada, não arbitrária."]}],"attrs":{"id":"lesson-A05-s5"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["6. Conservação e documentos digitais"]},{"tag":"p","children":["Conservação inclui condições ambientais, manuseio e proteção contra riscos. Em documentos digitais, integridade, autenticidade, acesso, cópias de segurança e formatos sustentáveis também importam."]}],"attrs":{"id":"lesson-A05-s6"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["Exemplos resolvidos passo a passo"]},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 1"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Documento usado diariamente pelo setor. Em qual fase?"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Corrente, pois possui uso administrativo frequente."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 2"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Documento sem uso frequente, aguardando prazo para destinação."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Intermediário."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 3"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Servidor quer destruir caixas antigas sem consultar tabela."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Procedimento incorreto; é necessário verificar temporalidade, destinação e autorização aplicáveis."],"tone":"solution"}],"tone":"example"}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Pegadinha"],"tone":"label"},{"tag":"h2","children":["Pegadinhas e erros frequentes"]},{"tag":"ul","children":[{"tag":"li","children":["Achar que arquivo permanente é “documento velho”."]},{"tag":"li","children":["Confundir classificação com ordenação."]},{"tag":"li","children":["Eliminar por falta de espaço sem temporalidade."]},{"tag":"li","children":["Desconsiderar gestão de documentos digitais."]}]}],"tone":"attention"},{"tag":"section","children":[{"tag":"span","children":["Resumo"],"tone":"label"},{"tag":"h2","children":["Resumo de prova"]},{"tag":"ul","children":[{"tag":"li","children":["Corrente = uso frequente."]},{"tag":"li","children":["Intermediário = aguarda destinação."]},{"tag":"li","children":["Permanente = guarda definitiva por valor."]},{"tag":"li","children":["Classificação ≠ ordenação."]},{"tag":"li","children":["Temporalidade define prazo e destino."]},{"tag":"li","children":["Eliminação precisa ser autorizada e segura."]}]}],"tone":"summary"},{"tag":"section","children":[{"tag":"h2","children":["Checklist de domínio"]},{"tag":"ul","children":[{"tag":"li","children":["☐ Entender ciclo de vida dos documentos."]},{"tag":"li","children":["☐ Diferenciar arquivos corrente, intermediário e permanente."]},{"tag":"li","children":["☐ Compreender classificação, temporalidade e eliminação controlada."]}]},{"tag":"p","children":["Meta do módulo: 80% ou mais nas questões, sem depender de consulta."]}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Para aprofundar"]},{"tag":"h2","children":["Referências e conteúdos auxiliares"]},{"tag":"aside","children":[{"tag":"span","children":["Referência complementar"],"tone":"label"},{"tag":"p","children":["Na cartilha do Conarq, procure ciclo vital, classificação, avaliação e tabela de temporalidade. Diferencie transferência para arquivo intermediário de recolhimento ao permanente."]}],"tone":"reference"},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Conarq — Criação e desenvolvimento de arquivos públicos municipais"],"attrs":{"href":"https://www.gov.br/conarq/pt-br/centrais-de-conteudo/publicacoes/Cartilha_criacao_arquivos_municipais.pdf"}},{"tag":"small","children":["Consulte especialmente gestão de documentos, protocolo, classificação, avaliação e destinação."]}]},{"tag":"li","children":[{"tag":"a","children":["Brasil — Lei 8.159/1991, política nacional de arquivos"],"attrs":{"href":"https://www.planalto.gov.br/ccivil_03/leis/l8159.htm"}},{"tag":"small","children":["Fundamentos de gestão documental e guarda de documentos públicos."]}]}]},{"tag":"p","children":["Referências externas de apoio consultadas para este material em 27/09/2026. A origem das questões é o material autoral do projeto; estes links não indicam que uma instituição publicou ou validou os exercícios. As páginas externas precisam de internet. Em informática, confira a versão do programa; em legislação, observe o recorte e as regras de atualização do edital."]}],"attrs":{"id":"lesson-A05-referencias"},"tone":"sources"}]}
