s":{"id":"lesson-A08-esquema"},"tone":"diagram"},{"tag":"div","children":[{"tag":"h2","children":["Mapa do conteúdo"]},{"tag":"ol","children":[{"tag":"li","children":[{"tag":"a","children":["1. Levantamento de dados"],"attrs":{"href":"#lesson-A08-s1"}}]},{"tag":"li","children":[{"tag":"a","children":["2. Previsão de materiais"],"attrs":{"href":"#lesson-A08-s2"}}]},{"tag":"li","children":[{"tag":"a","children":["3. Gastos com pessoal"],"attrs":{"href":"#lesson-A08-s3"}}]},{"tag":"li","children":[{"tag":"a","children":["4. Previsto x realizado"],"attrs":{"href":"#lesson-A08-s4"}}]},{"tag":"li","children":[{"tag":"a","children":["5. Prestação de contas"],"attrs":{"href":"#lesson-A08-s5"}}]},{"tag":"li","children":[{"tag":"a","children":["6. Conferência"],"attrs":{"href":"#lesson-A08-s6"}}]}],"tone":"contents"}],"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["1. Levantamento de dados"]},{"tag":"p","children":["Antes de prever gastos, identifique quantidades, preços, periodicidade e histórico. Um cálculo simples pode ser “quantidade × custo unitário × número de períodos”. A qualidade da previsão depende da qualidade dos dados."]}],"attrs":{"id":"lesson-A08-s1"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["2. Previsão de materiais"]},{"tag":"p","children":["Consumo médio ajuda a estimar necessidade, mas deve ser ajustado por eventos sazonais, mudança de demanda, estoque existente e tempo de reposição. Previsão não é certeza: é estimativa fundamentada."]}],"attrs":{"id":"lesson-A08-s2"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["3. Gastos com pessoal"]},{"tag":"p","children":["Em questões básicas, podem aparecer multiplicações de quantidade de pessoas, valores e períodos. Na prática, gastos de pessoal têm componentes legais adicionais; o edital pede noções e cálculos básicos, portanto foque na estrutura do cálculo apresentado."]}],"attrs":{"id":"lesson-A08-s3"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["4. Previsto x realizado"]},{"tag":"p","children":["Comparar previsto e realizado identifica desvios. Variação absoluta = realizado−previsto; percentual = variação/previsto×100%. Desvio deve ser analisado, não automaticamente considerado erro."]}],"attrs":{"id":"lesson-A08-s4"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["5. Prestação de contas"]},{"tag":"p","children":["Prestação de contas reúne registros e documentos para demonstrar origem, aplicação e resultado dos recursos/valores sob responsabilidade da unidade. Comprovantes devem ser íntegros, coerentes e vinculados ao fato registrado."]}],"attrs":{"id":"lesson-A08-s5"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["6. Conferência"]},{"tag":"p","children":["Conferência aritmética, documental e de autorização reduz erros. Totais devem bater com subtotais e documentos; divergências precisam ser justificadas/corrigidas conforme procedimento."]}],"attrs":{"id":"lesson-A08-s6"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["Exemplos resolvidos passo a passo"]},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 1"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Setor consome 20 caixas/mês a R$35. Previsão de 6 meses?"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," 20×35×6=R$4.200, desconsiderando estoque e variações para o exemplo."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 2"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Previsto R$10.000; realizado R$11.500. Desvio?"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," R$1.500 acima; percentual 1.500/10.000=15%."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 3"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Nota comprova valor, mas não está vinculada ao pedido/recebimento."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," A documentação de prestação fica frágil; é preciso manter relação entre autorização, aquisição, recebimento e comprovante."],"tone":"solution"}],"tone":"example"}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Pegadinha"],"tone":"label"},{"tag":"h2","children":["Pegadinhas e erros frequentes"]},{"tag":"ul","children":[{"tag":"li","children":["Confundir previsão com gasto efetivo."]},{"tag":"li","children":["Calcular percentual de desvio sobre realizado em vez do previsto."]},{"tag":"li","children":["Guardar comprovante sem relação com o fato."]},{"tag":"li","children":["Somar valores sem conferir unidade/período."]}]}],"tone":"attention"},{"tag":"section","children":[{"tag":"span","children":["Resumo"],"tone":"label"},{"tag":"h2","children":["Resumo de prova"]},{"tag":"ul","children":[{"tag":"li","children":["Previsão usa quantidade, custo e período."]},{"tag":"li","children":["Compare previsto x realizado."]},{"tag":"li","children":["Desvio percentual usa previsto como base."]},{"tag":"li","children":["Prestação de contas exige documentação coerente e rastreável."]},{"tag":"li","children":["Conferência é numérica e documental."]}]}],"tone":"summary"},{"tag":"section","children":[{"tag":"h2","children":["Checklist de domínio"]},{"tag":"ul","children":[{"tag":"li","children":["☐ Montar previsões simples de gastos."]},{"tag":"li","children":["☐ Distinguir previsão, realizado e saldo."]},{"tag":"li","children":["☐ Entender lógica básica de prestação de contas e documentação comprobatória."]}]},{"tag":"p","children":["Meta do módulo: 80% ou mais nas questões, sem depender de consulta."]}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Para aprofundar"]},{"tag":"h2","children":["Referências e conteúdos auxiliares"]},{"tag":"aside","children":[{"tag":"span","children":["Referência complementar"],"tone":"label"},{"tag":"p","children":["Leia os arts. 58, 62 e 63 da Lei 4.320/1964 para distinguir empenho, liquidação e pagamento. Treine planilhas com previsto, realizado, saldo e documento comprobatório."]}],"tone":"reference"},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Brasil — Lei 4.320/1964"],"attrs":{"href":"https://www.planalto.gov.br/ccivil_03/leis/l4320.htm"}},{"tag":"small","children":["Normas gerais de direito financeiro; arts. 58, 62 e 63 para etapas da despesa."]}]},{"tag":"li","children":[{"tag":"a","children":["Brasil — Constituição Federal, texto compilado"],"attrs":{"href":"https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm"}},{"tag":"small","children":["Leia os dispositivos indicados no módulo e suas remissões no texto oficial."]}]}]},{"tag":"p","children":["Referências externas de apoio consultadas para este material em 27/09/2026. A origem das questões é o material autoral do projeto; estes links não indicam que uma instituição publicou ou validou os exercícios. As páginas externas precisam de internet. Em informática, confira a versão do programa; em legislação, observe o recorte e as regras de atualização do edital."]}],"attrs":{"id":"lesson-A08-referencias"},"tone":"sources"}]}
