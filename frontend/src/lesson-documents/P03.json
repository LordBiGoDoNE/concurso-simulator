}]},{"tag":"text","attrs":{"x":"680","y":"230","fill":"#234951","font-size":"24","font-weight":"700","text-anchor":"start"},"children":[{"tag":"tspan","attrs":{"x":"680","dy":"0"},"children":["Pista do contexto"]}]},{"tag":"text","attrs":{"x":"680","y":"271","fill":"#234951","font-size":"22","font-weight":"400","text-anchor":"start"},"children":[{"tag":"tspan","attrs":{"x":"680","dy":"0"},"children":["Portas pode indicar"]},{"tag":"tspan","attrs":{"x":"680","dy":"28"},"children":["oportunidades."]}]}]}]}]},{"tag":"div","children":[{"tag":"ul","children":[{"tag":"li","children":[{"tag":"strong","children":["Literal:"]}," A porta da sala está aberta."]},{"tag":"li","children":[{"tag":"strong","children":["Figurado:"]}," O curso abriu portas profissionais."]},{"tag":"li","children":[{"tag":"strong","children":["Pista do contexto:"]}," Portas pode indicar oportunidades."]}]}],"tone":"description"},{"tag":"aside","children":[{"tag":"span","children":["Atenção"],"tone":"label"},{"tag":"p","children":["A expressão figurada transfere uma ideia para outro campo de sentido. Identifique primeiro o que a frase comunica como um todo."]}],"tone":"attention"}],"attrs":{"id":"lesson-P03-esquema"},"tone":"diagram"},{"tag":"div","children":[{"tag":"h2","children":["Mapa do conteúdo"]},{"tag":"ol","children":[{"tag":"li","children":[{"tag":"a","children":["1. Denotação e conotação"],"attrs":{"href":"#lesson-P03-s1"}}]},{"tag":"li","children":[{"tag":"a","children":["2. Metáfora"],"attrs":{"href":"#lesson-P03-s2"}}]},{"tag":"li","children":[{"tag":"a","children":["3. Metonímia"],"attrs":{"href":"#lesson-P03-s3"}}]},{"tag":"li","children":[{"tag":"a","children":["4. Ironia e efeitos"],"attrs":{"href":"#lesson-P03-s4"}}]}],"tone":"contents"}],"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["1. Denotação e conotação"]},{"tag":"p","children":["Sentido próprio ou denotativo é o uso mais literal e convencional. Sentido figurado ou conotativo amplia ou desloca esse significado por associação. Em “a porta está aberta”, porta é literal; em “a educação abre portas”, “portas” representa oportunidades."]},{"tag":"p","children":["O contexto decide. A mesma palavra pode ser literal em uma frase e figurada em outra."]}],"attrs":{"id":"lesson-P03-s1"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["2. Metáfora"]},{"tag":"p","children":["Metáfora aproxima realidades sem usar conectivo comparativo explícito. “Aquele servidor é uma ponte entre os setores” não o transforma fisicamente em ponte: atribui a ele a função de ligar partes."]},{"tag":"div","children":["Pergunta útil: “qual característica de um elemento foi transferida para o outro?”"],"tone":"note"}],"attrs":{"id":"lesson-P03-s2"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["3. Metonímia"]},{"tag":"p","children":["Metonímia ocorre por relação de proximidade: autor pela obra (“li Machado de Assis”), recipiente pelo conteúdo (“bebeu um copo”), instituição por seus agentes (“a prefeitura informou”). Não é semelhança; é associação."]}],"attrs":{"id":"lesson-P03-s3"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["4. Ironia e efeitos"]},{"tag":"p","children":["Ironia diz ou sugere algo em contraste com o sentido literal, geralmente para criticar ou produzir humor. Identificá-la exige contexto, porque isoladamente a frase pode parecer elogio."]}],"attrs":{"id":"lesson-P03-s4"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["Exemplos resolvidos passo a passo"]},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 1"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," “A burocracia engoliu o pedido.”"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Uso figurado: burocracia não engole fisicamente. A imagem sugere que o pedido ficou preso, atrasado ou absorvido pelo processo."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 2"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," “Li Clarice Lispector nas férias.”"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Metonímia: o nome da autora representa sua obra."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 3"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," Depois de três falhas seguidas, alguém diz “Que sistema perfeito!”."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," O contexto torna o elogio literal incompatível com os fatos; trata-se de ironia."],"tone":"solution"}],"tone":"example"}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Pegadinha"],"tone":"label"},{"tag":"h2","children":["Pegadinhas e erros frequentes"]},{"tag":"ul","children":[{"tag":"li","children":["Achar que toda comparação é metáfora."]},{"tag":"li","children":["Confundir metonímia (proximidade) com metáfora (semelhança)."]},{"tag":"li","children":["Ignorar o contexto na identificação de ironia."]}]}],"tone":"attention"},{"tag":"section","children":[{"tag":"span","children":["Resumo"],"tone":"label"},{"tag":"h2","children":["Resumo de prova"]},{"tag":"ul","children":[{"tag":"li","children":["Denotação = literal; conotação = figurada."]},{"tag":"li","children":["Metáfora transfere traços por semelhança."]},{"tag":"li","children":["Metonímia substitui por proximidade/associação."]},{"tag":"li","children":["Ironia depende do contraste contextual."]}]}],"tone":"summary"},{"tag":"section","children":[{"tag":"h2","children":["Checklist de domínio"]},{"tag":"ul","children":[{"tag":"li","children":["☐ Distinguir linguagem literal de figurada."]},{"tag":"li","children":["☐ Reconhecer metáfora, metonímia e ironia em exemplos simples."]},{"tag":"li","children":["☐ Interpretar o efeito produzido por escolhas figuradas."]}]},{"tag":"p","children":["Meta do módulo: 80% ou mais nas questões, sem depender de consulta."]}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Para aprofundar"]},{"tag":"h2","children":["Referências e conteúdos auxiliares"]},{"tag":"aside","children":[{"tag":"span","children":["Referência complementar"],"tone":"label"},{"tag":"p","children":["Crie duas frases com “raiz”: uma sobre uma planta e outra sobre a origem de um problema. Depois explique por que apenas a segunda depende de uma transferência de sentido."]}],"tone":"reference"},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Inep — Matrizes e escalas do Saeb"],"attrs":{"href":"https://www.gov.br/inep/pt-br/areas-de-atuacao/avaliacao-e-exames-educacionais/saeb/matrizes-e-escalas"}},{"tag":"small","children":["Apoio às habilidades de leitura e interpretação. Não corresponde à matriz do concurso de Limeira."]}]},{"tag":"li","children":[{"tag":"a","children":["Presidência da República — Manual de Redação, 3ª edição"],"attrs":{"href":"https://www.gov.br/cidades/pt-br/midia/documentos/pdf/manualderedacao.pdf"}},{"tag":"small","children":["Clareza, redação oficial, concordância, regência e pontuação. Referência de apoio; modelos locais podem ter regras próprias."]}]}]},{"tag":"p","children":["Referências externas de apoio consultadas para este material em 27/09/2026. A origem das questões é o material autoral do projeto; estes links não indicam que uma instituição publicou ou validou os exercícios. As páginas externas precisam de internet. Em informática, confira a versão do programa; em legislação, observe o recorte e as regras de atualização do edital."]}],"attrs":{"id":"lesson-P03-referencias"},"tone":"sources"}]}
