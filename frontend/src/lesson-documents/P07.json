scription"},{"tag":"aside","children":[{"tag":"span","children":["Atenção"],"tone":"label"},{"tag":"p","children":["O termo mais próximo do verbo nem sempre é o núcleo do sujeito. Expressões intercaladas podem distrair a leitura."]}],"tone":"attention"}],"attrs":{"id":"lesson-P07-esquema"},"tone":"diagram"},{"tag":"div","children":[{"tag":"h2","children":["Mapa do conteúdo"]},{"tag":"ol","children":[{"tag":"li","children":[{"tag":"a","children":["1. Regra geral verbal"],"attrs":{"href":"#lesson-P07-s1"}}]},{"tag":"li","children":[{"tag":"a","children":["2. Sujeito composto"],"attrs":{"href":"#lesson-P07-s2"}}]},{"tag":"li","children":[{"tag":"a","children":["3. Verbos impessoais"],"attrs":{"href":"#lesson-P07-s3"}}]},{"tag":"li","children":[{"tag":"a","children":["4. Concordância nominal"],"attrs":{"href":"#lesson-P07-s4"}}]}],"tone":"contents"}],"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["1. Regra geral verbal"]},{"tag":"p","children":["O verbo concorda em número e pessoa com o núcleo do sujeito. “Os documentos chegaram”; “A documentação chegou”. Antes de olhar o substantivo mais próximo do verbo, identifique o núcleo real do sujeito."]},{"tag":"div","children":["Em “A relação dos candidatos foi publicada”, o núcleo é “relação”, singular; “dos candidatos” é complemento do nome."],"tone":"note"}],"attrs":{"id":"lesson-P07-s1"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["2. Sujeito composto"]},{"tag":"p","children":["Sujeito composto anteposto tende a levar o verbo ao plural: “O diretor e a secretária assinaram”. Quando posposto, há construções em que a concordância pode variar conforme a norma e o contexto, mas em concurso é essencial reconhecer a forma plural como opção segura quando os núcleos são distintos."]}],"attrs":{"id":"lesson-P07-s2"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["3. Verbos impessoais"]},{"tag":"p","children":["“Haver” com sentido de existir ou ocorrer é impessoal e fica no singular: “Havia problemas”, “Houve reuniões”. O verbo “fazer” indicando tempo decorrido ou fenômeno meteorológico também permanece no singular: “Faz dois anos”."]},{"tag":"p","children":["Em locução verbal, a impessoalidade se transmite ao auxiliar: “Deve haver vagas”, e não “devem haver”."]}],"attrs":{"id":"lesson-P07-s3"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["4. Concordância nominal"]},{"tag":"p","children":["Artigos, adjetivos, pronomes adjetivos e numerais concordam com o substantivo. Em “documentos e certidões atualizados”, o adjetivo no masculino plural pode abranger substantivos de gêneros diferentes. Expressões como “é proibido/é proibida” dependem da presença de determinante: “É proibido entrada” (estrutura cristalizada) versus “É proibida a entrada”."]}],"attrs":{"id":"lesson-P07-s4"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["Exemplos resolvidos passo a passo"]},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 1"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," “A lista de documentos necessários ___ disponível.” Use está/estão."]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," “Está”, porque o núcleo do sujeito é “lista”, singular."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 2"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," “Devem haver vagas” está correto?"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Não. “Haver” com sentido de existir é impessoal; em locução: “Deve haver vagas”."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 3"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," “Fazem três meses que estudo” está correto?"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," Não. “Fazer” indicando tempo decorrido é impessoal: “Faz três meses”."],"tone":"solution"}],"tone":"example"}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Pegadinha"],"tone":"label"},{"tag":"h2","children":["Pegadinhas e erros frequentes"]},{"tag":"ul","children":[{"tag":"li","children":["Concordar o verbo com o termo mais próximo, ignorando o núcleo do sujeito."]},{"tag":"li","children":["Flexionar “haver” no sentido de existir."]},{"tag":"li","children":["Flexionar “fazer” em indicação de tempo decorrido."]},{"tag":"li","children":["Esquecer a concordância transmitida em locuções impessoais."]}]}],"tone":"attention"},{"tag":"section","children":[{"tag":"span","children":["Resumo"],"tone":"label"},{"tag":"h2","children":["Resumo de prova"]},{"tag":"ul","children":[{"tag":"li","children":["Verbo concorda com núcleo do sujeito."]},{"tag":"li","children":["Haver = existir → singular."]},{"tag":"li","children":["Fazer = tempo decorrido → singular."]},{"tag":"li","children":["Deve haver, pode haver, costuma haver."]},{"tag":"li","children":["Adjetivo concorda com o(s) substantivo(s) a que se refere."]}]}],"tone":"summary"},{"tag":"section","children":[{"tag":"h2","children":["Checklist de domínio"]},{"tag":"ul","children":[{"tag":"li","children":["☐ Aplicar a concordância verbal com diferentes tipos de sujeito."]},{"tag":"li","children":["☐ Reconhecer verbos impessoais, especialmente haver e fazer."]},{"tag":"li","children":["☐ Aplicar concordância nominal em construções frequentes."]}]},{"tag":"p","children":["Meta do módulo: 80% ou mais nas questões, sem depender de consulta."]}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Para aprofundar"]},{"tag":"h2","children":["Referências e conteúdos auxiliares"]},{"tag":"aside","children":[{"tag":"span","children":["Referência complementar"],"tone":"label"},{"tag":"p","children":["No Manual de Redação, leia concordância verbal e nominal. Reescreva três frases do singular para o plural, ajustando artigos, adjetivos e verbos."]}],"tone":"reference"},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Presidência da República — Manual de Redação, 3ª edição"],"attrs":{"href":"https://www.gov.br/cidades/pt-br/midia/documentos/pdf/manualderedacao.pdf"}},{"tag":"small","children":["Clareza, redação oficial, concordância, regência e pontuação. Referência de apoio; modelos locais podem ter regras próprias."]}]},{"tag":"li","children":[{"tag":"a","children":["Academia Brasileira de Letras — VOLP"],"attrs":{"href":"https://www.academia.org.br/nossa-lingua/busca-no-vocabulario"}},{"tag":"small","children":["Consulta de grafia e classe gramatical. O vocabulário não é um dicionário de significados."]}]}]},{"tag":"p","children":["Referências externas de apoio consultadas para este material em 27/09/2026. A origem das questões é o material autoral do projeto; estes links não indicam que uma instituição publicou ou validou os exercícios. As páginas externas precisam de internet. Em informática, confira a versão do programa; em legislação, observe o recorte e as regras de atualização do edital."]}],"attrs":{"id":"lesson-P07-referencias"},"tone":"sources"}]}
