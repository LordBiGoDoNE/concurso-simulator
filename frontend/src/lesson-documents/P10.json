art"},"children":[{"tag":"tspan","attrs":{"x":"103","dy":"0"},"children":["Fusão"]}]},{"tag":"text","attrs":{"x":"62","y":"381","fill":"#234951","font-size":"22","font-weight":"400","text-anchor":"start"},"children":[{"tag":"tspan","attrs":{"x":"62","dy":"0"},"children":["a + a = à"]}]},{"tag":"rect","attrs":{"x":"504","y":"304","width":"432","height":"133","rx":"12","fill":"#fff","stroke":"#cadbd2"},"children":[]},{"tag":"text","attrs":{"x":"522","y":"334","fill":"#16796d","font-size":"15","font-weight":"700","text-anchor":"start"},"children":[{"tag":"tspan","attrs":{"x":"522","dy":"0"},"children":["04"]}]},{"tag":"text","attrs":{"x":"565","y":"337","fill":"#234951","font-size":"23","font-weight":"700","text-anchor":"start"},"children":[{"tag":"tspan","attrs":{"x":"565","dy":"0"},"children":["Frase"]}]},{"tag":"text","attrs":{"x":"524","y":"381","fill":"#234951","font-size":"22","font-weight":"400","text-anchor":"start"},"children":[{"tag":"tspan","attrs":{"x":"524","dy":"0"},"children":["Dirigiu-se à secretaria."]}]},{"tag":"line","attrs":{"x1":"480","y1":"211","x2":"499","y2":"211","stroke":"#7da39a","stroke-width":"3","marker-end":"url(#lesson-P10-figure-1-arrow)"},"children":[]},{"tag":"line","attrs":{"x1":"480","y1":"370","x2":"499","y2":"370","stroke":"#7da39a","stroke-width":"3","marker-end":"url(#lesson-P10-figure-1-arrow)"},"children":[]}]}]}]},{"tag":"div","children":[{"tag":"ul","children":[{"tag":"li","children":[{"tag":"strong","children":["Regência:"]}," Dirigir-se exige preposição a."]},{"tag":"li","children":[{"tag":"strong","children":["Termo feminino:"]}," A secretaria admite artigo a."]},{"tag":"li","children":[{"tag":"strong","children":["Fusão:"]}," a + a = à"]},{"tag":"li","children":[{"tag":"strong","children":["Frase:"]}," Dirigiu-se à secretaria."]}]}],"tone":"description"},{"tag":"aside","children":[{"tag":"span","children":["Atenção"],"tone":"label"},{"tag":"p","children":["O teste do masculino ajuda: “dirigiu-se ao setor” sugere “dirigiu-se à secretaria”. Use-o com palavras equivalentes e confira a construção."]}],"tone":"attention"}],"attrs":{"id":"lesson-P10-esquema"},"tone":"diagram"},{"tag":"div","children":[{"tag":"h2","children":["Mapa do conteúdo"]},{"tag":"ol","children":[{"tag":"li","children":[{"tag":"a","children":["1. O que é crase"],"attrs":{"href":"#lesson-P10-s1"}}]},{"tag":"li","children":[{"tag":"a","children":["2. Teste do masculino"],"attrs":{"href":"#lesson-P10-s2"}}]},{"tag":"li","children":[{"tag":"a","children":["3. Casos comuns de crase"],"attrs":{"href":"#lesson-P10-s3"}}]},{"tag":"li","children":[{"tag":"a","children":["4. Casos sem crase"],"attrs":{"href":"#lesson-P10-s4"}}]},{"tag":"li","children":[{"tag":"a","children":["5. Crase e regência"],"attrs":{"href":"#lesson-P10-s5"}}]}],"tone":"contents"}],"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["1. O que é crase"]},{"tag":"p","children":["Crase é a fusão de dois sons/vogais “a”. Na escrita, o acento grave marca essa fusão. O caso mais frequente é preposição “a” exigida pelo termo anterior + artigo feminino “a/as” admitido pelo termo seguinte: “dirigir-se à escola”."]},{"tag":"p","children":["Portanto, não basta haver palavra feminina. É preciso verificar duas condições: regência antes e possibilidade de artigo depois."]}],"attrs":{"id":"lesson-P10-s1"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["2. Teste do masculino"]},{"tag":"p","children":["Troque o termo feminino por masculino equivalente. Se surgir “ao”, há forte indicação de crase: “fui à escola” → “fui ao colégio”. Se ficar apenas “a”, não há crase: “entreguei a ela” → não existe “ao ele”."]}],"attrs":{"id":"lesson-P10-s2"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["3. Casos comuns de crase"]},{"tag":"ul","children":[{"tag":"li","children":["Antes de locuções femininas: à tarde, à medida que, às vezes."]},{"tag":"li","children":["Antes de nome feminino que admite artigo e é regido por “a”."]},{"tag":"li","children":["Com horas determinadas: às 8h, à uma hora."]},{"tag":"li","children":["Com demonstrativos aquele(s), aquela(s), aquilo, quando houver preposição: referi-me àquele processo."]}]}],"attrs":{"id":"lesson-P10-s3"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["4. Casos sem crase"]},{"tag":"ul","children":[{"tag":"li","children":["Antes de palavra masculina: a prazo, a pé."]},{"tag":"li","children":["Antes de verbo: a partir, a estudar."]},{"tag":"li","children":["Antes de pronomes pessoais: a ela, a mim."]},{"tag":"li","children":["Em expressões com palavras repetidas: cara a cara."]},{"tag":"li","children":["Quando existe apenas artigo ou apenas preposição."]}]}],"attrs":{"id":"lesson-P10-s4"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["5. Crase e regência"]},{"tag":"p","children":["Muitos erros de crase são, na verdade, erros de regência. “Obedecer” exige “a”; “obedecer às normas” tem crase porque “normas” admite artigo. Já “visitar a escola” tem apenas artigo, pois “visitar” é transitivo direto: não há crase."]}],"attrs":{"id":"lesson-P10-s5"},"tone":"section"},{"tag":"section","children":[{"tag":"h2","children":["Exemplos resolvidos passo a passo"]},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 1"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," “Dirigi-me ___ secretaria.”"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," “à secretaria”. “Dirigir-se” exige preposição “a” e “secretaria” admite artigo “a”. Teste: dirigi-me ao setor."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 2"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," “Entreguei o documento ___ ela.”"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," “a ela”, sem crase. Pronome pessoal não admite artigo feminino nesse contexto."],"tone":"solution"}],"tone":"example"},{"tag":"div","children":[{"tag":"span","children":["Exemplo resolvido"],"tone":"label"},{"tag":"h3","children":["Exemplo 3"]},{"tag":"p","children":[{"tag":"strong","children":["Situação:"]}," “A reunião começa ___ 14 horas.”"]},{"tag":"div","children":[{"tag":"strong","children":["Resolução:"]}," “às 14 horas”, pois horas determinadas recebem crase, salvo contextos em que outra preposição já apareça."],"tone":"solution"}],"tone":"example"}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Pegadinha"],"tone":"label"},{"tag":"h2","children":["Pegadinhas e erros frequentes"]},{"tag":"ul","children":[{"tag":"li","children":["Colocar crase apenas porque a palavra seguinte é feminina."]},{"tag":"li","children":["Usar crase antes de verbo ou pronome pessoal."]},{"tag":"li","children":["Não verificar a regência do termo anterior."]},{"tag":"li","children":["Confundir “visitar a escola” com “ir à escola”."]}]}],"tone":"attention"},{"tag":"section","children":[{"tag":"span","children":["Resumo"],"tone":"label"},{"tag":"h2","children":["Resumo de prova"]},{"tag":"ul","children":[{"tag":"li","children":["Crase = preposição a + artigo a/as (ou demonstrativo compatível)."]},{"tag":"li","children":["Teste do masculino: se der “ao”, tende a haver crase."]},{"tag":"li","children":["Não há crase antes de verbo, masculino e pronome pessoal."]},{"tag":"li","children":["Horas determinadas: às 8h."]},{"tag":"li","children":["Estude crase junto com regência."]}]}],"tone":"summary"},{"tag":"section","children":[{"tag":"h2","children":["Checklist de domínio"]},{"tag":"ul","children":[{"tag":"li","children":["☐ Identificar quando há preposição “a” + artigo “a/as”."]},{"tag":"li","children":["☐ Aplicar testes de substituição por masculino e por “para a”."]},{"tag":"li","children":["☐ Reconhecer casos obrigatórios, proibidos e facultativos."]}]},{"tag":"p","children":["Meta do módulo: 80% ou mais nas questões, sem depender de consulta."]}],"tone":"section"},{"tag":"section","children":[{"tag":"span","children":["Para aprofundar"]},{"tag":"h2","children":["Referências e conteúdos auxiliares"]},{"tag":"aside","children":[{"tag":"span","children":["Referência complementar"],"tone":"label"},{"tag":"p","children":["Crie uma tabela de três linhas: antes de palavra masculina, antes de verbo e antes de nome feminino com artigo. Escreva um exemplo de cada caso e justifique a presença ou ausência do acento grave."]}],"tone":"reference"},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Presidência da República — Manual de Redação, 3ª edição"],"attrs":{"href":"https://www.gov.br/cidades/pt-br/midia/documentos/pdf/manualderedacao.pdf"}},{"tag":"small","children":["Clareza, redação oficial, concordância, regência e pontuação. Referência de apoio; modelos locais podem ter regras próprias."]}]},{"tag":"li","children":[{"tag":"a","children":["Academia Brasileira de Letras — VOLP"],"attrs":{"href":"https://www.academia.org.br/nossa-lingua/busca-no-vocabulario"}},{"tag":"small","children":["Consulta de grafia e classe gramatical. O vocabulário não é um dicionário de significados."]}]}]},{"tag":"p","children":["Referências externas de apoio consultadas para este material em 27/09/2026. A origem das questões é o material autoral do projeto; estes links não indicam que uma instituição publicou ou validou os exercícios. As páginas externas precisam de internet. Em informática, confira a versão do programa; em legislação, observe o recorte e as regras de atualização do edital."]}],"attrs":{"id":"lesson-P10-referencias"},"tone":"sources"}]}
